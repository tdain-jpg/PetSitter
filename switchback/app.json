{
  "expo": {
    "name": "Switchback",
    "slug": "switchback",
    "scheme": "switchback",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.switchback.app"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.switchback.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
