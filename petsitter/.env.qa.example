# Credentials for the automated QA agent (.claude/agents/qa-tester.md).
# Copy to .env.qa and fill in. .env.qa is gitignored — never commit real values.
#
# Use a DEDICATED throwaway account, never a real user's. Its data is treated as
# disposable: the QA agent creates and deletes pets and guides as it tests.
QA_EMAIL=tcdain+qapaws@gmail.com
QA_PASSWORD=

# Second account, for the sitter side. The owner account cannot invite itself —
# migration 0019 refuses any address already belonging to a household member —
# so exercising SitterHome, check-ins and the sitter invite gate needs a real
# second user. This account must never join the owner's household.
QA_SITTER_EMAIL=tcdain+qasitter@gmail.com
QA_SITTER_PASSWORD=
